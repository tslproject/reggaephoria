# Neon PostgreSQL pooled connection URL for application runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon direct connection URL for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_WHATSAPP="6288210516736"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional seed password; defaults to admin12345 if unset
SEED_ADMIN_PASSWORD="admin12345"
