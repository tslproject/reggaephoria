generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  GATE_STAFF
}

enum TransactionStatus {
  WAITING_PAYMENT
  PAID
  CANCELLED
}

enum TicketStatus {
  UNUSED
  USED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  scans        ScanLog[]
}

model Event {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String           @db.Text
  banner       String?
  location     String
  eventDate    DateTime
  createdAt    DateTime         @default(now())
  products     TicketProduct[]
  transactions Transaction[]
}

model TicketProduct {
  id                   String            @id @default(cuid())
  eventId              String
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                 String
  description          String?           @db.Text
  imageData            Bytes?            @db.ByteA
  imageMimeType        String?
  price                Int
  quota                Int
  approvalPasswordHash String
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  transactionItems     TransactionItem[]
}

model Promo {
  id            String       @id @default(cuid())
  name          String
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  startDate     DateTime
  endDate       DateTime
  active        Boolean      @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  whatsapp     String
  email        String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  @@index([whatsapp])
}

model Transaction {
  id           String            @id @default(cuid())
  invoice      String            @unique
  customerId   String
  customer     Customer          @relation(fields: [customerId], references: [id])
  eventId      String
  event        Event             @relation(fields: [eventId], references: [id])
  promoId      String?
  promo        Promo?            @relation(fields: [promoId], references: [id])
  total        Int
  status       TransactionStatus @default(WAITING_PAYMENT)
  verifyToken  String            @unique @default(cuid())
  createdAt    DateTime          @default(now())
  items        TransactionItem[]
  tickets      Ticket[]
  paymentLogs  PaymentLog[]
  whatsappLogs WhatsappLog[]
}

model TransactionItem {
  id            String        @id @default(cuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       TicketProduct @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Int
}

model Ticket {
  id            String       @id @default(cuid())
  serial        Int          @unique @default(autoincrement())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ticketCode    String       @unique
  qrData        String
  status        TicketStatus @default(UNUSED)
  createdAt     DateTime     @default(now())
  scanLogs      ScanLog[]
}

model PaymentLog {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        String
  createdAt     DateTime    @default(now())
}

model WhatsappLog {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  phone         String
  message       String      @db.Text
  createdAt     DateTime    @default(now())
}

model ScanLog {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Admin?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  result    String
  createdAt DateTime @default(now())
}
